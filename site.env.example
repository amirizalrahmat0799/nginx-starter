# Copy to site.env and edit:  cp site.env.example site.env
# Then run:                    sudo ./scripts/setup.sh

# Your domain. For the local VirtualBox VM use a .test name (reserved for testing,
# never exists on the real internet), e.g. mizal.test. On a VPS use your real domain.
DOMAIN=mizal.test

# Also answer on www.<DOMAIN>? (true/false). Your DNS or hosts file needs that name too.
INCLUDE_WWW=false

# What the site serves:
#   static -> files from /var/www/<DOMAIN> (starts with html/index.html from this repo)
#   proxy  -> forwards every request to an app, e.g. a Spring Boot service
MODE=static

# Only for MODE=proxy: where your app listens, as seen from the VM.
UPSTREAM=http://127.0.0.1:8080

# HTTPS:
#   none        -> plain HTTP on port 80
#   self-signed -> HTTPS with a certificate made on the VM (local VM; browser shows a warning)
#   letsencrypt -> free trusted certificate (VPS only: DNS must point to the server, ports 80/443 open)
HTTPS=none

# Only for HTTPS=letsencrypt: expiry notices from Let's Encrypt go here.
EMAIL=you@example.com

# What the site does in MODE=proxy: forward every request to your app.
# (Rendered by scripts/setup.sh; ${...} values come from site.env.)

# Largest upload Nginx will accept (default is only 1m).
client_max_body_size 10m;

location / {
    proxy_pass ${UPSTREAM};
    include snippets/starter/proxy.conf;
}


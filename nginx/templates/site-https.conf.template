# Site: ${DOMAIN}  (HTTPS with a self-signed certificate)
# Generated by nginx-starter/scripts/setup.sh. Edit the template in the repo and re-run it, not this file.

# 1) Anything on plain HTTP gets redirected to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAMES};
    return 301 https://$host$request_uri;
}

# 2) The real site, on HTTPS.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    ${HTTP2_DIRECTIVE}
    server_name ${SERVER_NAMES};

    ssl_certificate     ${CERT_DIR}/${DOMAIN}.crt;
    ssl_certificate_key ${CERT_DIR}/${DOMAIN}.key;
    include snippets/starter/ssl.conf;

    access_log /var/log/nginx/${DOMAIN}.access.log;
    error_log  /var/log/nginx/${DOMAIN}.error.log;

    include snippets/starter/security-headers.conf;
    include snippets/starter/site-${DOMAIN}.conf;
}
